# Copia este archivo a ".env" para personalizar docker compose (no subas .env a git).

# --- demo (productos y pedidos) ---
# Por defecto usa H2 en memoria. Para Supabase (PostgreSQL):
# DEMO_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres
# DEMO_DATASOURCE_USERNAME=postgres
# DEMO_DATASOURCE_PASSWORD=<tu-password>

# --- inventory-service ---
# INVENTORY_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres
# INVENTORY_DATASOURCE_USERNAME=postgres
# INVENTORY_DATASOURCE_PASSWORD=<tu-password>

# Solo para pruebas locales: abre los endpoints de inventario sin token
# INVENTORY_SECURITY_OPEN=true

# --- frontend (se aplican al construir la imagen) ---
# VITE_API_URL=http://localhost:8080/api/products
# VITE_ORDERS_API_URL=http://localhost:8080/api/orders

# --- RabbitMQ (demo e inventory-service) ---
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest
